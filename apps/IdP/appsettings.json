{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mongo": "mongodb://localhost:27017"
  },
  "IdP": {
    "Name": "MinApiLib IdP",
    "Issuer": null,
    "ForwardedHeaders": true,
    "Database": "idp",
    "CookieSameSite": "Lax",
    "Registration": {
      "Enabled": true,
      "RequireEmailVerification": false
    },
    "Admin": {
      "UserName": "admin",
      "Password": null,
      "Email": null
    },
    "Email": {
      "From": "no-reply@localhost",
      "FromName": null,
      "Smtp": {
        "Host": null,
        "Port": 587,
        "UserName": null,
        "Password": null,
        "UseSsl": false
      }
    },
    "Events": {
      "RetentionDays": 30
    },
    "Password": {
      "RequiredLength": 8,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 5
    }
  }
}
