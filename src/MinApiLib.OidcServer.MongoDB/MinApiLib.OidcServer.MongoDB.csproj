<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>MongoDB stores for MinApiLib.OidcServer: clients, resources, CORS origins, persisted grants, device codes and signing keys, with TTL indexes that expire grants and device codes.</Description>
    <Product>MinApiLib.OidcServer</Product>
    <PackageTags>OAuth2;OAuth 2.0;OpenID Connect;OIDC;MongoDB;MinApiLib</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MinApiLib.OidcServer\MinApiLib.OidcServer.csproj" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>
  <ItemGroup>
    <!-- The package ships its own README instead of the repository's. -->
    <None Remove="$(RepoRoot)README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
