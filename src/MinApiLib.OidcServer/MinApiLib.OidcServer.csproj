<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>OpenID Connect and OAuth 2.0 server for ASP.NET Core built on MinApiLib endpoints and attribute-based dependency injection. A new implementation derived from IdentityServer4 (Apache-2.0), with no dependency on IdentityServer packages.</Description>
    <Product>MinApiLib.OidcServer</Product>
    <PackageTags>OAuth2;OAuth 2.0;OpenID Connect;OIDC;Security;Identity;MinimalApi;MinApiLib</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="MinApiLib.Endpoints" />
    <PackageReference Include="MinApiLib.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <!-- The package ships its own README instead of the repository's. -->
    <None Remove="$(RepoRoot)README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MinApiLib.OidcServer.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
