<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>DPoP (RFC 9449) building blocks shared by clients, resource servers and MinApiLib.Oidc.Server: keys, proofs, RFC 7638 thumbprints, nonces and the protocol's names.</Description>
    <Product>MinApiLib.Oidc</Product>
    <PackageTags>OAuth2;OAuth 2.0;OpenID Connect;OIDC;DPoP;Proof of possession;JWK;MinApiLib</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>
  <ItemGroup>
    <!-- The package ships its own README instead of the repository's. -->
    <None Remove="$(RepoRoot)README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
