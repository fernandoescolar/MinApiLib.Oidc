<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>DPoP (RFC 9449) for ASP.NET Core JWT bearer authentication: accepts Authorization: DPoP, validates the proof of DPoP-bound access tokens against cnf.jkt, rejects them as bearer tokens, issues DPoP nonces and answers with DPoP challenges. Works with any OAuth 2.0 server.</Description>
    <Product>MinApiLib.Oidc</Product>
    <PackageTags>OAuth2;OAuth 2.0;OpenID Connect;OIDC;DPoP;Proof of possession;JWT;Bearer;Resource server;ASP.NET Core;MinApiLib</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\MinApiLib.Oidc.DPoP\MinApiLib.Oidc.DPoP.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
  <ItemGroup>
    <!-- The package ships its own README instead of the repository's. -->
    <None Remove="$(RepoRoot)README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MinApiLib.Oidc.JwtBearer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
