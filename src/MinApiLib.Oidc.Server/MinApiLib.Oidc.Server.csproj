<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>OpenID Connect and OAuth 2.0 server for ASP.NET Core built on MinApiLib endpoints and attribute-based dependency injection. Includes code derived from IdentityServer4 4.1.2 (Apache-2.0); it does not depend on any IdentityServer package.</Description>
    <Product>MinApiLib.Oidc</Product>
    <!-- Parts of this package are derived from IdentityServer4 and IdentityModel: see NOTICE. -->
    <Copyright>Copyright (c) Fernando Escolar. Portions Copyright (c) Brock Allen &amp; Dominick Baier</Copyright>
    <PackageTags>OAuth2;OAuth 2.0;OpenID Connect;OIDC;Security;Identity;MinimalApi;MinApiLib</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\MinApiLib.Oidc.DPoP\MinApiLib.Oidc.DPoP.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="MinApiLib.Endpoints" />
    <PackageReference Include="MinApiLib.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <!-- The package ships its own README instead of the repository's. -->
    <None Remove="$(RepoRoot)README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MinApiLib.Oidc.Server.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
