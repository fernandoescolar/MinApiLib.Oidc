# Test code may log directly; the LoggerMessage rules apply to the shipped libraries only.
[*.cs]
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.CA2253.severity = none
# Rules that add noise but no value in test code (constant arrays in InlineData-style setups, test doubles, etc.).
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1829.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1860.severity = none
dotnet_diagnostic.CA1806.severity = none
dotnet_diagnostic.CA1825.severity = none
dotnet_diagnostic.CA1309.severity = none
dotnet_diagnostic.CA1725.severity = none
dotnet_diagnostic.CA2201.severity = none
dotnet_diagnostic.CA1510.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1727.severity = none
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1854.severity = none
