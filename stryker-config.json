{
  "stryker-config": {
    "solution": "MinApiLib.Oidc.slnx",
    "project": "MinApiLib.Oidc.Server.csproj",
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "configuration": "Debug",
    "mutate": [
      "**/Features/**/*.cs",
      "**/Core/**/*.cs",
      "!**/Core/IdentityModel/**/*.cs",
      "!**/Logging/**/*.cs",
      "!**/*Log.cs",
      "!**/LoggerExtensions.cs"
    ],
    "ignore-methods": [
      "*Log*",
      "ToString"
    ],
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    }
  }
}
